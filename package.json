{
  "name": "canvas-student-dashboard",
  "version": "1.0.0",
  "description": "Personal Canvas LMS Student Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./public/tailwind.input.css -o ./public/tailwind.generated.css --minify",
    "build": "npm run build:css && node build-static.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
